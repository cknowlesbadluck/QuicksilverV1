{
  "name": "Quicksilver Swift Devcontainer",
  // Official Swift image: the previous ghcr.io/devcontainers/features/swift
  // feature does not exist in devcontainers/features, which made every
  // Codespaces prebuild fail at "Create Template".
  "image": "swift:6.1-jammy",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "swiftlang.swift-vscode",
        "eamodio.gitlens"
      ]
    }
  },
  "postCreateCommand": "swift --version || true; bash scripts/install-opencode.sh || true"
}
