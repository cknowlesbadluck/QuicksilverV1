{
  "name": "mercury-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Mercury Gateway — Cloudflare Workers Free reverse proxy for Quicksilver cloud AI (scaffold).",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "esbuild eval/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=eval/.build/cli.mjs --log-level=warning && node eval/.build/cli.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
